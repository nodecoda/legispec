# Executable witnesses for rules/aarch64-vector-shift.lspec.
#
# Every rule index is covered once, either by a positive step or by an
# explicit unreachable declaration.  Rules 12 and 14 are the min halves of
# clampNumElements(0, v2s32, v4s32) and clampNumElements(0, v2s64, v2s64):
# both need a fixed v1, which LLVM represents as a scalar.

witness custom_scalar_32_shadowing_legal {
    query = (G_SHL, [s32, s32])
    step = Custom rule 0
    reason = "customIf precedes legalFor, so {i32,i32} is Custom"
}

witness legal_s64_pair {
    query = (G_SHL, [s64, s64])
    step = Legal rule 1
    reason = "explicit legalFor pair"
}

witness widen_amount_s24 {
    query = (G_SHL, [s32, s24])
    step = WidenScalar t1 -> s32 rule 2
    reason = "widenScalarToNextPow2(1) fires before any clamp"
}

witness widen_source_s24 {
    query = (G_SHL, [s24, s32])
    step = WidenScalar t0 -> s32 rule 3
    reason = "the amount s32 is a power of two; slot 0 is widened next"
}

witness clamp_amount_min_s8 {
    query = (G_SHL, [s32, s8])
    step = WidenScalar t1 -> s32 rule 4
    reason = "s8 is a power of two, so clampScalar(1) min fires"
}

witness clamp_amount_max_s128 {
    query = (G_SHL, [s32, s128])
    step = NarrowScalar t1 -> s64 rule 5
    reason = "clampScalar(1) max"
}

witness clamp_source_min_s16 {
    query = (G_SHL, [s16, s32])
    step = WidenScalar t0 -> s32 rule 6
    reason = "slot 1 is already at s32; clampScalar(0) min fires"
}

witness clamp_source_max_s128 {
    query = (G_SHL, [s128, s32])
    step = NarrowScalar t0 -> s64 rule 7
    reason = "clampScalar(0) max"
}

witness clamp_v8s8_min_v4s8 {
    query = (G_SHL, [v4s8, v4s8])
    step = MoreElements t0 -> v8s8 rule 8
    reason = "clampNumElements(0, v8s8, v16s8) min"
}

witness clamp_v8s8_max_v32s8 {
    query = (G_SHL, [v32s8, v32s8])
    step = FewerElements t0 -> v16s8 rule 9
    reason = "clampNumElements(0, v8s8, v16s8) max"
}

witness clamp_v4s16_min_v3s16 {
    query = (G_SHL, [v3s16, v2s16])
    step = MoreElements t0 -> v4s16 rule 10
    reason = "clampNumElements(0, v4s16, v8s16) min"
}

witness clamp_v4s16_max_v16s16 {
    query = (G_SHL, [v16s16, v2s16])
    step = FewerElements t0 -> v8s16 rule 11
    reason = "clampNumElements(0, v4s16, v8s16) max"
}

witness clamp_v2s32_min_unreachable {
    query = (G_SHL, [v2s32, v2s32])
    unreachable = 12
    reason = "requires a fixed vector with fewer than 2 s32 lanes; LLVM represents v1 as a scalar"
}

witness clamp_v2s32_max_v8s32 {
    query = (G_SHL, [v8s32, v2s32])
    step = FewerElements t0 -> v4s32 rule 13
    reason = "clampNumElements(0, v2s32, v4s32) max"
}

witness clamp_v2s64_min_unreachable {
    query = (G_SHL, [v2s64, v2s64])
    unreachable = 14
    reason = "requires a fixed vector with fewer than 2 s64 lanes; LLVM represents v1 as a scalar"
}

witness clamp_v2s64_max_v4s64 {
    query = (G_SHL, [v4s64, v2s64])
    step = FewerElements t0 -> v2s64 rule 15
    reason = "clampNumElements(0, v2s64, v2s64) max"
}

witness more_elements_v3s32 {
    query = (G_SHL, [v3s32, v2s32])
    step = MoreElements t0 -> v4s32 rule 16
    reason = "v3s32 escapes the lane clamps and is rounded up"
}

witness min_scalar_same_as_s64_s32 {
    query = (G_SHL, [s64, s32])
    step = WidenScalar t1 -> s64 rule 17
    reason = "minScalarSameAs(1, 0): 64 > 32"
}

witness scalarize_v2s128 {
    query = (G_SHL, [v2s128, v2s128])
    step = FewerElements t0 -> s128 rule 18
    reason = "vector element size > 64 is scalarized"
}

witness min_elt_same_as_v2s64_v2s32 {
    query = (G_SHL, [v2s64, v2s32])
    step = WidenScalar t1 -> v2s64 rule 19
    reason = "minScalarSameAs sees 64 > 64 and declines; the element-wise rule widens slot 1"
}

witness max_elt_same_as_copies_vector_type {
    query = (G_SHL, [v2s32, s64])
    step = NarrowScalar t1 -> v2s32 rule 20
    reason = "maxScalarEltSameAsIf assigns the whole source type, so a scalar amount becomes a vector"
}

witness negative_scalar_32_is_not_legal {
    query = (G_SHL, [s32, s32])
    not_action = Legal
    reason = "the first customIf shadows the legalFor pair"
}

witness negative_min_scalar_same_as_uses_total_size {
    query = (G_SHL, [v4s32, v4s8])
    not_rule = 17
    reason = "32 > 32 is false because slot 1 totals 32 bits; the element-wise rule handles it"
}
