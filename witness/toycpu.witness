    step  = NarrowScalar t1 -> s1 rule 4
}

witness carry_widen_carry_unreachable {
    query       = (G_UADDO, [s32, s1])
    unreachable = 3
    reason      = "predicate bits(t1) < 1 has no valid LLT"
}

