# ToyCPU witness corpus, spec v0.1
#
# 地位：这些证人是【意图】的载体，先于实现输出冻结。
# 推导来源：spec/ldsl-v0.1.md 的语法、宏展开与 first-match-wins 规则。
# 未参考解释器输出来编造期望；解释器只用于事后交叉验证。
#
# 格式
# ----
#   witness <name> {
#       query      = (<OPCODE>, [<types>] [, mem = [<ty>:<align_bits>]] [, imm = [<int>]])
#       step       = <Action> [t<N> -> <LLT>] [rule <N>]
#       not_rule   = <N>            # 反例：命中的规则不得是第 N 条
#       not_action = <Action>       # 反例：动作不得是该值
#       unreachable = <N>           # 该规则在 D 上不可达
#       reason     = "<text>"
#   }
#
# step 中的 rule 编号从 0 开始，对应宏展开后的位置（见 spec §2.6）。
#
# 统计（2026-10-19 冻结）
#   witnesses = 205
#   positives = 114（覆盖 87 条可达规则，部分规则有多条边界证人）
#   negatives = 89
#   unreachable = 2（G_UADDO rule 3、G_CONSTANT rule 1；见 spec/decisions.md D-0002）
#
# query.types 的语义
#   types 是【去重后的 generic type index 数组】，不是操作数数组。
#   G_UNMERGE_VALUES 的 (outs type0, variable_ops), (ins type1) 对应 [t0, t1]。
#   见 spec/domain.md §4.1 与 spec/decisions.md D-0001。

# ---------------------------------------------------------------------------
# G_ADD / G_SUB / G_AND / G_OR / G_XOR   (rules 0..2)
# ---------------------------------------------------------------------------

witness add_s32_legal {
    query = (G_ADD, [s32])
    step  = Legal rule 0
}

witness add_v4s32_legal {
    query = (G_ADD, [v4s32])
    step  = Legal rule 0
}

witness add_s16_widen {
    query = (G_ADD, [s16])
    step  = WidenScalar t0 -> s32 rule 1
}

witness add_s64_narrow {
    query = (G_ADD, [s64])
    step  = NarrowScalar t0 -> s32 rule 2
}

witness neg_add_s16_not_legal {
    query    = (G_ADD, [s16])
    not_rule = 0
}

witness neg_add_s32_not_widen {
    query    = (G_ADD, [s32])
    not_rule = 1
}

witness neg_add_s16_not_narrow {
    query    = (G_ADD, [s16])
    not_rule = 2
}

