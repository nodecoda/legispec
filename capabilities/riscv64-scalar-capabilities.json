{
  "version": 1,
  "description": "RISC-V RV64 scalar subset experiment, generic-rv64 (+64bit,+i; no M/Zmmul/Zbb/Zbc/Zbkc/P/V/F/D). Custom: 32-bit ADD/SUB, 32-bit shifts, 64-bit constants. Libcall: multiply, divide and remainder. Lower: carry/saturating/overflow, bit manipulation without Zbb/Zbkb, count-zeros/ctpop/ctls, abs/min-max/compare, divrem.",
  "custom": {
    "opcodes": [
      "G_ADD", "G_SUB",
      "G_SHL", "G_ASHR", "G_LSHR",
      "G_CONSTANT"
    ]
  },
  "libcall": {
    "opcodes": ["G_MUL", "G_SDIV", "G_UDIV", "G_UREM", "G_SREM"]
  },
  "lower": {
    "opcodes": [
      "G_UADDE", "G_UADDO", "G_USUBE", "G_USUBO",
      "G_SADDE", "G_SADDO", "G_SSUBE", "G_SSUBO",
      "G_UADDSAT", "G_SADDSAT", "G_USUBSAT", "G_SSUBSAT",
      "G_SSHLSAT", "G_USHLSAT",
      "G_SEXT_INREG", "G_FSHL", "G_FSHR",
      "G_ROTR", "G_ROTL", "G_BITREVERSE", "G_BSWAP",
      "G_CTLZ", "G_CTTZ", "G_CTLZ_ZERO_POISON", "G_CTTZ_ZERO_POISON",
      "G_CTLS", "G_CTPOP",
      "G_SMULH", "G_UMULH", "G_SMULO", "G_UMULO",
      "G_SDIVREM", "G_UDIVREM",
      "G_ABS", "G_ABDS", "G_ABDU",
      "G_UMAX", "G_UMIN", "G_SMAX", "G_SMIN",
      "G_SCMP", "G_UCMP"
    ]
  }
}