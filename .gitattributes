# Default: text, LF in the repository and in the working tree.
* text=auto eol=lf

# Rule assets are text; keep one canonical LF form.
*.lspec text eol=lf

# Prose and Windows-only scripts keep CRLF in the working tree.
*.md  text eol=crlf
*.ps1 text eol=crlf

# Binary-ish evidence never gets line-ending conversion.
*.exe binary
*.png binary
